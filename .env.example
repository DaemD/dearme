# Copy to .env.local for local development, and set the same names in Vercel (Project Settings, Environment Variables).
# Never commit real values.

OPENAI_API_KEY=sk-your-key
# Signs login tokens. Use a long random string.
SECRET_KEY=any-long-random-string
# The one password that lets Zeneb in (there is no signup). 12+ characters.
ACCESS_PASSWORD=choose-a-long-password
# Only you hold this. It opens /api/admin (graph.json and the backup). 16+ characters.
ADMIN_KEY=choose-another-long-secret

# Backup storage (Upstash Redis, added from Vercel's Marketplace). Either pair of names works.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Starting facts about her (ground truth). One line of JSON: {"ops": [...]} is NOT used here, just the ops array.
# Locally you may use the gitignored file api/_data/seed.json instead. On Vercel this variable is the only route.
# SEED_OPS_JSON=[]

# Models (optional)
# CHAT_MODEL=gpt-4o-mini
# MEMORY_MODEL_FAST=gpt-4o-mini
# MEMORY_MODEL_SLOW=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1   (tests point this at a fake server)
